	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>MissionUnlock</key>
		<string>Med præcis position kan appen se, at du står ved netop dette sted. Uden den kan opgaven ikke låses op.</string>
	</dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Byens Gåder bruger din position til at se, at du står på det sted, opgaven handler om. Positionen forlader aldrig telefonen, og der gemmes hverken rute eller historik.</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchImage</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
