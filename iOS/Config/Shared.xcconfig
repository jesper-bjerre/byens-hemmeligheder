// Fælles byggeindstillinger for app-targetet.
//
// Denne fil er committet. Alt maskinspecifikt hører hjemme i `Local.xcconfig`,
// som er gitignoreret — se `Local.xcconfig.example`.

// Signering
//
// `DEVELOPMENT_TEAM` sættes i Local.xcconfig og står derfor ikke her. Uden den
// kan der bygges til simulator, men ikke til en fysisk enhed. Det er den
// rigtige byttehandel for et public repo: en frisk klon kan køre og teste med
// det samme, og ingen udvikleridentitet følger med i historikken.
CODE_SIGN_STYLE = Automatic

// Inkluderingen er **valgfri** (`?`). Mangler filen — på en frisk klon eller i
// CI — fejler bygningen ikke; den kan bare ikke signere til en enhed.
// Hvor indholdet hentes fra.
//
// Den udrullede backend er standarden, og den står her — i en **committet**
// fil. Stod den kun i den gitignorerede Local.xcconfig, ville en arkivering på
// en maskine uden den fil give en app med tom adresse, og appen stopper med
// vilje ved opstart frem for at vise en tom skærm. På TestFlight er det et
// nedbrud ved start.
//
// Værdien står **før** inkluderingen med vilje. Xcconfig læser oppefra og ned,
// så en tilordning efter `#include?` ville overskrive den, der lige er læst fra
// Local.xcconfig.
//
// Skråstregerne brydes med $(), fordi // ellers læses som en kommentar.
BH_CONTENT_BASE_URL = https:/$()/byensgaader-api-p.azurewebsites.net

// Vil du køre Debug mod din egen maskine eller DEV, så sæt kun Debug-
// varianten i Local.xcconfig:
//   BH_CONTENT_BASE_URL[config=Debug] = http:/$()/localhost:5199
// En ukvalificeret lokal værdi ville også ramme Archive og sende et
// TestFlight-build mod localhost.
#include? "Local.xcconfig"
