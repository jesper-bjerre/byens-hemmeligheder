// Skabelon. Kopiér til `Local.xcconfig` og udfyld:
//
//     cp iOS/Config/Local.xcconfig.example iOS/Config/Local.xcconfig
//
// `Local.xcconfig` er gitignoreret og må aldrig committes.

// Dit Apple-udviklerteam. Nødvendigt for at bygge til en fysisk enhed.
//
// Find det med:
//
//     security find-identity -v -p codesigning
//     security find-certificate -c "<navnet fra listen>" -p \
//       | openssl x509 -noout -subject
//
// Team-id'et er `OU`-feltet i certifikatets subject — ti tegn, fx `A1B2C3D4E5`.
// Det kan også ses under Xcode ▸ Settings ▸ Accounts.
DEVELOPMENT_TEAM = <indsæt lokalt, commit aldrig>

// Hvor appen henter opgaver og medier fra.
//
// Der er intet bundlet indhold i appen (ADR 0004, forfatningens princip V).
// Mangler denne linje, stopper appen ved opstart frem for at vise en tom
// skærm, ingen ved hvorfor er tom.
//
// DEV i Debug (anbefalet under fælles test):
BH_CONTENT_BASE_URL[config=Debug] = https:/$()/byensgaader-api-d.azurewebsites.net
//
// En lokal backend i Debug i stedet — kræver `./backend/run.sh`:
// BH_CONTENT_BASE_URL[config=Debug] = http:/$()/localhost:5199
//
// Sæt aldrig en ukvalificeret BH_CONTENT_BASE_URL her. Release og Archive
// skal beholde PROD-adressen fra Shared.xcconfig.
